{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5001 }
      ],
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": ["Post"]
      // Eliminada la configuración de autenticación para este endpoint
    },
    {
      "DownstreamPathTemplate": "/api/auth/oauth2-login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5001 }
      ],
      "UpstreamPathTemplate": "/auth/oauth2-login",
      "UpstreamHttpMethod": ["Get"]
      // Eliminada la configuración de autenticación para este endpoint
    },
    {
      "DownstreamPathTemplate": "/api/auth/oauth2-callback",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5001 }
      ],
      "UpstreamPathTemplate": "/auth/oauth2-callback",
      "UpstreamHttpMethod": ["Get"]
      // Eliminada la configuración de autenticación para este endpoint
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5002 }
      ],
      "UpstreamPathTemplate": "/billing/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5003 }
      ],
      "UpstreamPathTemplate": "/api/gateway/health",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
